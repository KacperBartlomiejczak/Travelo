{
  "expo": {
    "name": "traveling",
    "slug": "traveling",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "traveling",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.baxton.traveling",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F4EC",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 58,
          "dark": {
            "backgroundColor": "#171716",
            "image": "./assets/images/splash-icon-dark.png"
          }
        }
      ],
      "expo-sqlite",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Travelo uses your photos so you can add them to a trip and choose its cover.",
          "cameraPermission": "Travelo uses your camera only to scan the barcode on a boarding pass.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Travelo uses your camera only to scan the barcode on a boarding pass.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      "expo-document-picker",
      "expo-asset",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e682ee9d-2d9b-4810-84f2-1cf200b363ff"
      }
    },
    "owner": "baxton"
  }
}
