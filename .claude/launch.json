{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "expo-web",
      "runtimeExecutable": "env",
      "runtimeArgs": ["CI=1", "pnpm", "exec", "expo", "start", "--web", "--port", "8081"],
      "port": 8081
    },
    {
      "name": "expo-go-emulator",
      "runtimeExecutable": "powershell",
      "runtimeArgs": ["-NoProfile", "-Command", "$env:CI='1'; $env:REACT_NATIVE_PACKAGER_HOSTNAME='127.0.0.1'; pnpm exec expo start --port 8081"],
      "port": 8081
    }
  ]
}
